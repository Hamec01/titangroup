# /etc/titanor-time/gps-archive-pilot.env   (install as root:root, mode 0600)
# Consumed by titanor-time-gps-archive@pilot.service. Names and paths only — NO secrets.
# GPS_ARCHIVE_ENCRYPTION_KEY lives ONLY in the app env file below and is read by the container.

TT_GPS_ENV=pilot
TT_GPS_APP_CONTAINER=t97-pilot-app
TT_GPS_NET=t97-pilot-net
TT_GPS_ENVFILE=/home/deploy/app-data/t97-pilot/app.env
TT_GPS_STAGING=/home/deploy/app-data/t97-pilot/gps-archive-staging
TT_GPS_ARCHIVE_ROOT=/mnt/250gb/titanor-time-foundation/gps-archive-store
TT_GPS_KEEP_STAGING_DAYS=21

# --- production instance (create /etc/titanor-time/gps-archive-prod.env when R14 approaches) ---
# TT_GPS_ENV=prod
# TT_GPS_APP_CONTAINER=titanor-time-app-1
# TT_GPS_NET=<the prod app/db network>
# TT_GPS_ENVFILE=/home/deploy/app-data/titanor-time/app.env   (must contain GPS_ARCHIVE_ENCRYPTION_KEY)
# TT_GPS_STAGING=/home/deploy/app-data/titanor-time/gps-archive-staging
# TT_GPS_ARCHIVE_ROOT=/mnt/250gb/titanor-time-foundation/gps-archive-store   (shared — reading-day paths never collide)
