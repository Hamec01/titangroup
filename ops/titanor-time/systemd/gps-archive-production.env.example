# /etc/titanor-time/gps-archive-production.env   (install as root:root, mode 0600)
# Consumed by titanor-time-gps-archive@production.service. Names and paths only — NO secrets.
# GPS_ARCHIVE_ENCRYPTION_KEY lives ONLY in the app env file below (read by the container).

TT_GPS_ENV=production
TT_GPS_APP_CONTAINER=titanor-time-prod-app
TT_GPS_NET=titanor-time-prod-net
TT_GPS_ENVFILE=/home/deploy/app-data/titanor-time-prod/app.env
TT_GPS_STAGING=/home/deploy/app-data/titanor-time-prod/gps-archive-staging
TT_GPS_ARCHIVE_ROOT=/mnt/250gb/titanor-time-foundation/gps-archive-store
TT_GPS_KEEP_STAGING_DAYS=21
