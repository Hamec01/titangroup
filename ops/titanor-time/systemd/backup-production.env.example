# /etc/titanor-time/backup-production.env   (install as root:root, mode 0600)
# Consumed by titanor-time-backup@production.service. NO secrets — names and paths only.
# R14 production stack (titanor-time-prod-*), created 2026-09-01.

TT_ENV=production
TT_DB_CONTAINER=titanor-time-prod-db
TT_DB_USER=titanor_time_prod
TT_DB_NAME=titanor_time
TT_UPLOADS_DIR=/home/deploy/app-data/titanor-time-prod/uploads
TT_APP_CONTAINER=titanor-time-prod-app
TT_REPO_DIR=/home/deploy/projects/titanorgroup-worktrees/titanor-time-foundation
TT_BACKUP_ROOT=/home/deploy/backups/titanor-time-production
TT_MIRROR_ROOT=/mnt/250gb/titanor-time-foundation/backups/production
TT_KEEP_DAILY=7
TT_KEEP_WEEKLY=4
TT_KEEP_MONTHLY=12
TT_KEEP_EVENT_DAYS=30
