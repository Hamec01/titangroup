# /etc/titanor-time/backup-pilot.env   (install as root:root, mode 0600)
# Consumed by titanor-time-backup@pilot.service. Contains NO secrets — only names and paths.

TT_ENV=pilot
TT_DB_CONTAINER=t97-pilot-db
TT_DB_USER=t97_app
TT_DB_NAME=titanor_time_t97
TT_UPLOADS_DIR=/home/deploy/app-data/t97-pilot/uploads
TT_APP_CONTAINER=t97-pilot-app
TT_REPO_DIR=/home/deploy/projects/titanorgroup-worktrees/titanor-time-foundation
TT_BACKUP_ROOT=/home/deploy/backups/titanor-time-pilot
TT_MIRROR_ROOT=/mnt/250gb/titanor-time-foundation/backups/pilot
TT_KEEP_DAILY=7
TT_KEEP_WEEKLY=4
TT_KEEP_MONTHLY=12
TT_KEEP_EVENT_DAYS=30

# --- production instance (create /etc/titanor-time/backup-prod.env when R14 approaches) ---
# TT_ENV=prod
# TT_DB_CONTAINER=titanor-time-db-1
# TT_DB_USER=<from .env.titanor-time POSTGRES_USER>
# TT_DB_NAME=<from .env.titanor-time POSTGRES_DB>
# TT_UPLOADS_DIR=/home/deploy/app-data/titanor-time/uploads   (this is a symlink into the s3fs mount)
# TT_APP_CONTAINER=titanor-time-app-1
# TT_BACKUP_ROOT=/home/deploy/backups/titanor-time-prod
# TT_MIRROR_ROOT=/mnt/250gb/titanor-time-foundation/backups/prod
