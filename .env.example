# Admin login password (no registration)
ADMIN_PASSWORD=replace-with-strong-password

# Session secret for signing admin auth cookie
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional folder inside Cloudinary
CLOUDINARY_FOLDER=titangroup/services

# Optional: production persistence for service descriptions and image lists
# Use Supabase service role key only on the server side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
