  PENDING_ACTIVATION
  ACTIVE
  OFFBOARDING
  DEACTIVATED
}

enum ActivationTokenStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum AuthLevel {
  PASSWORD
  MFA_VERIFIED
}

enum AbsenceType {
  SICK_LEAVE
  VACATION
  UNPAID_LEAVE
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollPeriodStatus {
  OPEN
  LOCKED
  EXPORTED
}

enum TimesheetSubmissionCadence {
  WEEKLY
  BIWEEKLY
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  RETURNED
  FOREMAN_APPROVED
  FINAL_APPROVED
}

enum DayType {
  WORK
  SICK_LEAVE
  VACATION
  UNPAID_LEAVE
  PUBLIC_HOLIDAY
  OTHER
}

enum TimesheetVersionSource {
  WORKER
  CORRECTION
}

enum TimesheetReviewScopeType {
  SITE
  NON_SITE
}

enum TimesheetReviewScopePurpose {
  DATA
  EMPTY_FALLBACK
}

enum TimesheetReviewScopeStatus {
  PENDING
  APPROVED
  RETURNED
}

enum IdempotencyKeyStatus {
  PROCESSING
  COMPLETED
}

enum CorrectionRequestStatus {
  PENDING
  DRAFT_OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

// docs/titanor-time/T7A_1_ATTENDANCE_CLOCK_DESIGN.md §3 — Attendance Clock enums (T7A.1 schema
// foundation slice). Four deliberately separate axes per §3: raw device fact, server-derived
// decision, existing review status (untouched), UI label (never stored). Identifier text for
// P0001 trigger exceptions below follows the project's stable-uppercase-identifier convention
// (05_RAW_SQL_REGISTER.md §7), not the lowercase snake_case message text used in the design
// document's own SQL listings — see docs/titanor-time/05_RAW_SQL_REGISTER.md for the mapping.
enum ClockOperationType {
  CHECK_IN
  CHECK_OUT
}

enum GpsVerificationState {
  VERIFIED_INSIDE
  VERIFIED_OUTSIDE
  NOT_VERIFIED
}

enum GpsUnavailableReason {
  PERMISSION_DENIED
  TIMEOUT
  POSITION_UNAVAILABLE
  LOW_ACCURACY
}

enum ClockEventProcessingState {
  ACCEPTED
  NEEDS_REVIEW
}

enum SubmissionChannel {
  ONLINE
  OFFLINE_SYNC
}

enum ClockShiftMaterializationState {
  PENDING
  MATERIALIZED
}

enum ClockShiftFragmentProjectionState {
  PENDING
  SETTLED
}

enum ClockShiftAdjustmentType {
  EDITED
  REMOVED
  RESTORED_TO_RECORDED
}

enum ClockEventConflictType {
  CLIENT_EVENT_ID_REUSED
  DEVICE_SEQUENCE_REUSED
}

enum DeviceEventReceiptOutcome {
  ACCEPTED
  REJECTED_TERMINAL
}

enum UserKind {
  HUMAN
  SYSTEM
}

enum TimesheetReturnReason {
  HUMAN_REVIEW_RETURN
  SYSTEM_LATE_SYNC_REOPEN
}

enum AttendanceExceptionType {
  GPS_NOT_VERIFIED
  OUTSIDE_GEOFENCE_CHECKOUT
  SITE_MISMATCH_CHECKOUT
  DOUBLE_CHECK_IN
  CHECKOUT_WITHOUT_OPEN_SHIFT
  STALE_ASSIGNMENT
  GEOFENCE_VERSION_MISMATCH
  LATE_SYNC_AFTER_SUBMIT
  MISSING_CHECKOUT_AT_CUTOFF
  EXCESSIVE_CLOCK_SKEW
  CHECKOUT_CHRONOLOGY_ANOMALY
  EXCESSIVE_SHIFT_DURATION
  PERIOD_BOUNDARY_SPAN
  OVERLAPPING_SHIFT
}

enum AttendanceExceptionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Not used by any column in this schema-foundation slice — no resolution endpoint exists yet
// (§12 is out of scope). Declared here only because §3 lists it as part of the approved enum
// set; the future resolution API (§11/§12) will validate request bodies against these values.
enum AttendanceExceptionResolutionAction {
  DISMISS
  ACKNOWLEDGE_AS_VALID
  PAIR_ORPHAN_EVENTS
  CONFIRM_SOURCE_ASSIGNMENT
  REASON_EDIT
  FORCE_CLOSE_OPEN_SHIFT
}

enum SubmissionSource {
  MANUAL
  AUTO
}

enum AutoSubmissionResult {
  SUBMITTED_CLEAN
  SUBMITTED_WITH_EXCEPTIONS
  SKIPPED_ALREADY_SUBMITTED
  SKIPPED_NOT_ACTIONABLE
}

// T8.4A — docs/titanor-time/T8_REPORTS_DESIGN.md Addendum "T8.4A". CSV_V1 is a worked-time report
// (T8.1-T8.3's own canonical bucket/formula), not a payroll export — no money, no TES categories.
// A future PDF format gets its own enum value in a later additive migration, not this one.
enum ExportFormat {
  CSV_V1
}

enum ExportBatchKind {
  FULL
  CORRECTION
}

// Qualifications Matrix (2026-08-24). EMPLOYEE = selectable as a personal worker credential;
// COMPANY_REFERENCE = a company/industry standard (e.g. EN ISO 3834) shown as reference only,
// never offered in the employee qualification picker.
enum QualificationScope {
  EMPLOYEE
  COMPANY_REFERENCE
}

enum QualificationExpiryMode {
  REQUIRED
  OPTIONAL
  NONE
}

enum QualificationVerificationState {
  SELF_REPORTED
  VERIFIED
}

// Admin Notification Center (2026-08-24). Only qualification-expiry types exist today; the
// type enum is deliberately flat so future types (SYSTEM_WARNING, ATTENDANCE_ERROR, ...) can
// be added without redesigning AdminNotification/AdminNotificationDismissal.
enum AdminNotificationType {
  QUALIFICATION_EXPIRING_SOON
  QUALIFICATION_CRITICAL
  QUALIFICATION_EXPIRED
  QUALIFICATION_MISSING_EXPIRY
}

enum AdminNotificationSeverity {
  WARNING
  CRITICAL
}

model User {
  id                             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                       String                        @unique @db.VarChar(64)
  email                          String?                       @unique @db.VarChar(255)
  passwordHash                   String?                       @db.Text
  status                         UserStatus
  locale                         Locale
  twoFactorEnabled               Boolean                       @default(false)
  twoFactorSecret                String?                       @db.Text
  employeeId                     String?                       @unique @db.Uuid
  lastLoginAt                    DateTime?                     @db.Timestamptz(6)
  userKind                       UserKind                      @default(HUMAN)
  createdAt                      DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                      @updatedAt @db.Timestamptz(6)
  employee                       Employee?                     @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAbsences                Absence[]                     @relation("AbsenceCreatedBy")
  approvedAbsences               Absence[]                     @relation("AbsenceApprovedBy")
  assignedAssignments            SiteAssignment[]              @relation("SiteAssignmentAssignedBy")
  defaultForemanSites            WorkSite[]                    @relation("WorkSiteDefaultForeman")
  foremanAssignments             ForemanAssignment[]           @relation("ForemanAssignmentForeman")
  assignedForemanAssignments     ForemanAssignment[]           @relation("ForemanAssignmentAssignedBy")
  openedPeriods                  PayrollPeriod[]               @relation("PayrollPeriodOpenedBy")
  lockedPeriods                  PayrollPeriod[]               @relation("PayrollPeriodLockedBy")
  excludedParticipants           PayrollPeriodParticipant[]    @relation("PayrollPeriodParticipantExcludedBy")
  createdTemplateVersions        WorkScheduleTemplateVersion[] @relation("TemplateVersionCreatedBy")
  createdTimesheetVersions       TimesheetVersion[]            @relation("TimesheetVersionCreatedBy")
  reviewedTimesheetScopes        TimesheetReviewScope[]        @relation("TimesheetReviewScopeReviewedBy")
  requestedCorrections           CorrectionRequest[]           @relation("CorrectionRequestRequestedBy")
  decidedCorrections             CorrectionRequest[]           @relation("CorrectionRequestDecidedBy")
  openedCorrectionDrafts         CorrectionDraft[]             @relation("CorrectionDraftOpenedBy")
  issuedActivationTokens         ActivationToken[]             @relation("ActivationTokenCreatedBy")
  receivedSystemActivationTokens UserActivationToken[]         @relation("UserActivationTokenTarget")
  issuedSystemActivationTokens   UserActivationToken[]         @relation("UserActivationTokenCreatedBy")
  userRoles                      UserRole[]
  userSessions                   UserSession[]
  auditEvents                    AuditEvent[]
  idempotencyKeys                IdempotencyKey[]
  createdGeofenceVersions        WorkSiteGeofenceVersion[]     @relation("GeofenceVersionCreatedBy")
  clockShiftAdjustments          ClockShiftAdjustment[]        @relation("ClockShiftAdjustmentChangedBy")
  forceClosedClockShifts         ClockShift[]                  @relation("ClockShiftForceClosedBy")
  resolvedAttendanceExceptions   AttendanceException[]         @relation("AttendanceExceptionResolvedBy")
  updatedAttendancePolicies      CompanyAttendancePolicy[]     @relation("CompanyAttendancePolicyUpdatedBy")
  createdExportBatches           ExportBatch[]                 @relation("ExportBatchCreatedBy")
  createdSubmissionSchedules     TimesheetSubmissionSchedule[] @relation("TimesheetSubmissionScheduleCreatedBy")
  updatedSubmissionSchedules     TimesheetSubmissionSchedule[] @relation("TimesheetSubmissionScheduleUpdatedBy")
  assignedSubmissionSchedules    EmployeeTimesheetSchedule[]   @relation("EmployeeTimesheetScheduleAssignedBy")
  uploadedEmployeeContracts      EmployeeProfile[]             @relation("EmployeeProfileContractUploadedBy")
  verifiedEmployeeQualifications EmployeeQualification[]       @relation("EmployeeQualificationVerifiedBy")
  adminNotificationDismissals    AdminNotificationDismissal[]
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @unique @db.VarChar(32)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(128)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  validFrom DateTime  @default(now()) @db.Timestamptz(6)
  validTo   DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([roleId])
}

model UserSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(64)
  authLevel     AuthLevel @default(PASSWORD)
  mfaVerifiedAt DateTime? @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(6)
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.Text
  revokedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.1 "ActivationToken" — T7.9-adjacent activation
// vertical slice. tokenHash is HMAC-SHA256(ACTIVATION_TOKEN_HMAC_KEY, normalizedCode), not
// Argon2id — GET /api/auth/activate must find the row by a single deterministic equality
// lookup on the code the user actually typed/scanned, which Argon2id's per-call salting
// doesn't allow. @unique on tokenHash both enables that lookup and guards the
// (astronomically unlikely) HMAC collision case, per owner instruction.
model ActivationToken {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String                @db.Uuid
  tokenHash       String                @unique @db.VarChar(64)
  status          ActivationTokenStatus @default(PENDING)
  expiresAt       DateTime              @db.Timestamptz(6)
  createdByUserId String                @db.Uuid
  usedAt          DateTime?             @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User                  @relation("ActivationTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([employeeId, status])
  @@index([expiresAt])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.1 "UserActivationToken" — owner-confirmed schema
// checkpoint for system-user (FOREMAN) first-login credentials. Deliberately a separate table
// from ActivationToken, not a shared/nullable-FK generalization of it — ActivationToken and the
// worker activation flow built on it are already in production and are not touched by this
// migration. Same shape as ActivationToken (id/tokenHash/status/expiresAt/createdByUserId/usedAt/
// createdAt), keyed by userId instead of employeeId. Reuses the existing ActivationTokenStatus
// enum and the existing ACTIVATION_TOKEN_HMAC_KEY secret — no new enum, no new secret. tokenHash
// stores only the HMAC-SHA256 digest; the raw code is never persisted.
model UserActivationToken {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                @db.Uuid
  tokenHash       String                @unique @db.VarChar(64)
  status          ActivationTokenStatus @default(PENDING)
  expiresAt       DateTime              @db.Timestamptz(6)
  createdByUserId String                @db.Uuid
  usedAt          DateTime?             @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  user            User                  @relation("UserActivationTokenTarget", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User                  @relation("UserActivationTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model Employee {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeNumber        String                      @unique
  firstName             String
  lastName              String
  phone                 String?
  version               Int                         @default(1)
  createdAt             DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @db.Timestamptz(6)
  user                  User?
  employments           Employment[]
  absences              Absence[]
  activationTokens      ActivationToken[]
  siteAssignments       SiteAssignment[]
  periodParticipants    PayrollPeriodParticipant[]
  timesheets            Timesheet[]
  deviceInstallations   WorkerDeviceInstallation[]
  clockEvents           ClockEvent[]
  openShift             EmployeeOpenShift?
  clockShifts           ClockShift[]
  attendanceExceptions  AttendanceException[]
  clockEventIdConflicts ClockEventIdConflict[]
  exportItems           ExportItem[]
  submissionSchedules   EmployeeTimesheetSchedule[]
  profile               EmployeeProfile?
  qualifications        EmployeeQualification[]
  adminNotifications    AdminNotification[]
}

// Worker Profile feature (2026-08-24 plan) — optional, self-service worker info plus an
// admin-attached contract. 1:1 with Employee, kept as its own table (rather than columns on
// Employee) so this still-evolving, non-required feature stays isolated from the core
// Employee row everything else joins against. onDelete: Cascade is a safety net, not an
// expected path — Employee is never hard-deleted in this system (deactivation only).
model EmployeeProfile {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId               String    @unique @db.Uuid
  dateOfBirth              DateTime? @db.Date
  specialty                String?   @db.VarChar(120)
  skills                   String?   @db.Text
  photoPath                String?
  contractPath             String?
  contractUploadedByUserId String?   @db.Uuid
  contractUploadedAt       DateTime? @db.Timestamptz(6)
  // Worker Dossier feature (2026-08-26 plan). henkilötunnus is sensitive personal data — never
  // stored in plaintext. personalIdentityCodeEncrypted holds an AES-256-GCM ciphertext (base64,
  // lib/personal-data-encryption.ts); personalIdentityCodeLast4 is a display-only cache of the
  // final 4 characters (individual number + checksum) so masked UI ("••••••-••••1234") never
  // needs to decrypt just to render a list. Both are set/cleared together — never one without
  // the other.
  personalIdentityCodeEncrypted String? @db.Text
  personalIdentityCodeLast4     String? @db.VarChar(4)
  // Distinct from User.email (the login/account field) — this is the worker's HR/contact email
  // for the dossier, never written to automatically from account email.
  contactEmail             String?   @db.VarChar(255)
  addressStreet            String?   @db.VarChar(255)
  addressPostalCode        String?   @db.VarChar(32)
  addressCity              String?   @db.VarChar(120)
  addressCountry           String?   @db.VarChar(120)
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)
  employee                 Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contractUploadedByUser   User?     @relation("EmployeeProfileContractUploadedBy", fields: [contractUploadedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

// FK directly to Employee (not nested under EmployeeProfile) so a worker can add a card
// before any EmployeeProfile row exists yet.
// Additive upgrade (2026-08-24, Qualifications Matrix): definitionId links a row to the new
// QualificationDefinition catalog. Nullable — legacy rows and worker/admin "Other" custom
// entries keep working with definitionId=null, exactly as before. `name` stays required and
// keeps holding the display name (catalog nameEn/nameRu snapshot, or free text for custom
// entries) so every existing reader of `.name` keeps working unchanged.
model EmployeeQualification {
  id                 String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId         String                          @db.Uuid
  definitionId       String?                         @db.Uuid
  name               String                          @db.VarChar(120)
  certificateNumber  String?                         @db.VarChar(80)
  issuer             String?                         @db.VarChar(160)
  issuedOn           DateTime?                       @db.Date
  expiresOn          DateTime?                       @db.Date
  photoPath          String?
  verificationState  QualificationVerificationState @default(SELF_REPORTED)
  verifiedAt         DateTime?                       @db.Timestamptz(6)
  verifiedByUserId   String?                         @db.Uuid
  createdAt          DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                        @updatedAt @db.Timestamptz(6)
  employee           Employee                        @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  definition         QualificationDefinition?        @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedByUser     User?                           @relation("EmployeeQualificationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  adminNotifications AdminNotification[]

  @@index([employeeId])
  @@index([definitionId])
}

// Centralized qualification catalog (2026-08-24). `code` is the stable identifier used by the
// idempotent seed migration and by report/matrix filters — never reuse a retired code for a
// different qualification. FI has no translated catalog yet (§10 of the owner spec): UI must
// fall back to nameEn/descriptionEn for locale=FI rather than inventing a translation.
model QualificationDefinition {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                   @unique @db.VarChar(64)
  category               String                   @db.VarChar(64)
  scope                  QualificationScope
  nameEn                 String                   @db.VarChar(160)
  nameRu                 String                   @db.VarChar(160)
  descriptionEn          String?                  @db.Text
  descriptionRu          String?                  @db.Text
  expiryMode             QualificationExpiryMode
  isActive               Boolean                  @default(true)
  sortOrder              Int                      @default(0)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(6)
  employeeQualifications EmployeeQualification[]

  @@index([scope, isActive, sortOrder])
}

// Admin Notification Center (2026-08-24). Structured event, not a pre-rendered message string,
// so future non-qualification types (SYSTEM_WARNING, ATTENDANCE_ERROR, ...) reuse this table.
// `resolvedAt` = the system-level condition cleared (e.g. expiry extended past the threshold);
// distinct from per-admin dismissal, which lives entirely in AdminNotificationDismissal so
// admin A dismissing a notification never hides it for admin B. Active-notification dedup
// (one active row per employeeQualificationId+type+threshold) is enforced by a partial unique
// index added via raw SQL in this feature's migration (Prisma schema can't express a WHERE
// clause on an index) — see prisma/migrations/*_add_qualifications_and_notifications.
model AdminNotification {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                    AdminNotificationType
  severity                AdminNotificationSeverity
  employeeId              String?                      @db.Uuid
  employeeQualificationId String?                      @db.Uuid
  threshold               Int?
  createdAt               DateTime                     @default(now()) @db.Timestamptz(6)
  resolvedAt              DateTime?                    @db.Timestamptz(6)
  employee                Employee?                    @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employeeQualification   EmployeeQualification?       @relation(fields: [employeeQualificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dismissals              AdminNotificationDismissal[]

  @@index([resolvedAt, createdAt(sort: Desc)])
  @@index([employeeQualificationId])
  @@index([employeeId])
}

// Per-admin dismissal state, normalized out of AdminNotification so it's naturally per-user.
model AdminNotificationDismissal {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String            @db.Uuid
  userId         String            @db.Uuid
  dismissedAt    DateTime          @default(now()) @db.Timestamptz(6)
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model TimesheetSubmissionSchedule {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                      @db.VarChar(80)
  cadence           TimesheetSubmissionCadence
  weekStartsOn      Int                         @default(0)
  anchorDate        DateTime                    @db.Date
  isCompanyDefault  Boolean                     @default(false)
  active            Boolean                     @default(true)
  version           Int                         @default(1)
  createdByUserId   String?                     @db.Uuid
  updatedByUserId   String?                     @db.Uuid
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                    @updatedAt @db.Timestamptz(6)
  createdByUser     User?                       @relation("TimesheetSubmissionScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedByUser     User?                       @relation("TimesheetSubmissionScheduleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employeeSchedules EmployeeTimesheetSchedule[]
  payrollPeriods    PayrollPeriod[]

  @@index([active, cadence])
}

model AddressGeocodeCache {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryHash       String   @unique @db.Char(64)
  queryNormalized String   @db.VarChar(200)
  results         Json
  fetchedAt       DateTime @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([fetchedAt])
}

model GeocodingProviderState {
  provider      String   @id @db.VarChar(32)
  lastRequestAt DateTime @db.Timestamptz(6)
}

model EmployeeTimesheetSchedule {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String                      @db.Uuid
  scheduleId       String                      @db.Uuid
  effectiveFrom    DateTime                    @db.Date
  effectiveTo      DateTime?                   @db.Date
  assignedByUserId String                      @db.Uuid
  createdAt        DateTime                    @default(now()) @db.Timestamptz(6)
  employee         Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schedule         TimesheetSubmissionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUser   User                        @relation("EmployeeTimesheetScheduleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([employeeId, effectiveFrom])
  @@index([scheduleId, effectiveFrom, effectiveTo])
}

model Employment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId         String    @db.Uuid
  active             Boolean
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date
  deactivationReason String?   @db.Text
