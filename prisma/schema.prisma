// timesheet.submit (ЭТАП 7 sub-task 4), one per SITE with data plus at most one NON_SITE
// (DATA or EMPTY_FALLBACK) per version. TimesheetReviewProposal (child of this, created only by
// scope.return) is deliberately not part of this schema yet — no endpoint creates it until
// sub-task 5 (foreman/admin review), so there is nothing to reference it.
model TimesheetReviewScope {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetVersionId String                       @db.Uuid
  scopeType          TimesheetReviewScopeType
  scopePurpose       TimesheetReviewScopePurpose?
  siteId             String?                      @db.Uuid
  contextSiteId      String?                      @db.Uuid
  status             TimesheetReviewScopeStatus
  contentHash        String                       @db.VarChar(64)
  carriedFromScopeId String?                      @db.Uuid
  reviewedByUserId   String?                      @db.Uuid
  reviewedAt         DateTime?                    @db.Timestamptz(6)
  returnReason       String?                      @db.Text
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(6)
  timesheetVersion   TimesheetVersion             @relation(fields: [timesheetVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site               WorkSite?                    @relation("TimesheetReviewScopeSite", fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contextSite        WorkSite?                    @relation("TimesheetReviewScopeContextSite", fields: [contextSiteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  carriedFromScope   TimesheetReviewScope?        @relation("TimesheetReviewScopeCarriedFrom", fields: [carriedFromScopeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  carriedToScopes    TimesheetReviewScope[]       @relation("TimesheetReviewScopeCarriedFrom")
  reviewedByUser     User?                        @relation("TimesheetReviewScopeReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([id, timesheetVersionId])
  @@index([timesheetVersionId])
  @@index([siteId, status])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.8 — immutable, append-only (enforced by
// trg_audit_event_immutable in this migration's raw SQL, not by any API write path —
// audit.read is the only permission touching this table, per
// 02_ROLE_PERMISSION_MATRIX.md §2.10). actorUserId/entityId nullable per owner decision
// (2026-07-31): LOGIN_FAILED for an unrecognized identifier has no resolvable User and
// no single domain entity — entityType="AUTHENTICATION", entityId=NULL in that case.
model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  eventType   String   @db.VarChar(64)
  entityType  String   @db.VarChar(64)
  entityId    String?  @db.Uuid
  beforeValue Json?
  afterValue  Json?
  reason      String?  @db.Text
  requestId   String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.7 "CorrectionRequest"/"CorrectionDraft*" — T7.9
// (correction of a FINAL_APPROVED timesheet). request/draftId form a mutual 1:1 pointer pair
// exactly as documented: CorrectionDraft.correctionRequestId is the authoritative, required,
// unique backlink; CorrectionRequest.draftId is a nullable convenience pointer set at the same
// time (starts NULL at PENDING, set once correction.draft.edit opens the draft). CorrectionDraft
// has no plannedShift entity of its own (corrections compare only against basedOnVersionId, never
// a plan, §4.5) — CorrectionDraftSegment has no plannedShift FK, unlike TimesheetDraftSegment.
model CorrectionRequest {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetId            String                  @db.Uuid
  requestedByUserId      String                  @db.Uuid
  reason                 String                  @db.Text
  status                 CorrectionRequestStatus
  draftId                String?                 @unique @db.Uuid
  decidedByUserId        String?                 @db.Uuid
  decidedAt              DateTime?               @db.Timestamptz(6)
  resultingVersionId     String?                 @db.Uuid
  approvalOverride       Boolean                 @default(false)
  overrideReason         String?                 @db.Text
  pendingExport          Boolean                 @default(false)
  // T8.4B — docs/titanor-time/T8_REPORTS_DESIGN.md Addendum "T8.4B" §BE. Which ExportBatch (always
  // kind=CORRECTION, same period as this request's Timesheet — enforced by
  // trg_correction_request_covered_batch_check, not expressible as a CHECK/FK) covered this
  // correction, once pendingExport flips back to false. Set exactly once — immutable after that,
  // same trigger.
  coveredByExportBatchId String?                 @db.Uuid
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  timesheet              Timesheet               @relation(fields: [timesheetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedByUser        User                    @relation("CorrectionRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByUser          User?                   @relation("CorrectionRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resultingVersion       TimesheetVersion?       @relation("CorrectionRequestResultingVersion", fields: [resultingVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coveredByExportBatch   ExportBatch?            @relation("ExportBatchCoveredCorrections", fields: [coveredByExportBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  draft                  CorrectionDraft?        @relation("CorrectionRequestDraftPointer", fields: [draftId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  draftOwner             CorrectionDraft?        @relation("CorrectionDraftOwnRequest")

  @@index([timesheetId, status])
  @@index([requestedByUserId])
  @@index([decidedByUserId])
  @@index([coveredByExportBatchId])
}

model CorrectionDraft {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correctionRequestId String                   @unique @db.Uuid
  employeeId          String                   @db.Uuid
  basedOnVersionId    String                   @db.Uuid
  openedByUserId      String                   @db.Uuid
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  submittedAt         DateTime?                @db.Timestamptz(6)
  correctionRequest   CorrectionRequest        @relation("CorrectionDraftOwnRequest", fields: [correctionRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  basedOnVersion      TimesheetVersion         @relation("CorrectionDraftBaseVersion", fields: [basedOnVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openedByUser        User                     @relation("CorrectionDraftOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pointerFromRequest  CorrectionRequest?       @relation("CorrectionRequestDraftPointer")
  days                CorrectionDraftDay[]
  segments            CorrectionDraftSegment[]

  @@unique([id, employeeId])
}

model CorrectionDraftDay {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftId         String                   @db.Uuid
  date            DateTime                 @db.Date
  dayType         DayType
  confirmedZero   Boolean                  @default(false)
  sourceAbsenceId String?                  @db.Uuid
  note            String?                  @db.Text
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  draft           CorrectionDraft          @relation(fields: [draftId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceAbsence   Absence?                 @relation(fields: [sourceAbsenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  segments        CorrectionDraftSegment[]

  @@unique([draftId, date])
  @@unique([id, draftId])
  @@unique([id, draftId, date])
  @@unique([id, date])
  @@index([sourceAbsenceId])
}

model CorrectionDraftSegment {
  id                         String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftDayId                 String                        @db.Uuid
  draftId                    String                        @db.Uuid
  employeeId                 String                        @db.Uuid
  date                       DateTime                      @db.Date
  startAt                    DateTime                      @db.Timestamptz(6)
  endAt                      DateTime                      @db.Timestamptz(6)
  siteId                     String                        @db.Uuid
  workAreaId                 String?                       @db.Uuid
  sourceAssignmentId         String                        @db.Uuid
  originClockShiftFragmentId String?                       @db.Uuid
  createdAt                  DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                      @updatedAt @db.Timestamptz(6)
  draftDay                   CorrectionDraftDay            @relation(fields: [draftDayId, draftId, date], references: [id, draftId, date], onDelete: Cascade, onUpdate: Cascade)
  draft                      CorrectionDraft               @relation(fields: [draftId, employeeId], references: [id, employeeId], onDelete: Cascade, onUpdate: Cascade)
  site                       WorkSite                      @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea                   WorkArea?                     @relation(fields: [siteId, workAreaId], references: [siteId, id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment           SiteAssignment                @relation(fields: [sourceAssignmentId, employeeId, siteId], references: [id, employeeId, siteId], onDelete: Restrict, onUpdate: Cascade)
  originClockShiftFragment   ClockShiftFragment?           @relation("CorrectionDraftSegmentOrigin", fields: [originClockShiftFragmentId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)
  breaks                     CorrectionDraftBreakSegment[]

  @@index([draftDayId, draftId])
  @@index([draftId, employeeId])
  @@index([sourceAssignmentId, employeeId, siteId])
  @@index([siteId, date])
  @@index([originClockShiftFragmentId])
}

model CorrectionDraftBreakSegment {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftSegmentId String                 @db.Uuid
  startAt        DateTime               @db.Timestamptz(6)
  endAt          DateTime               @db.Timestamptz(6)
  paid           Boolean
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  draftSegment   CorrectionDraftSegment @relation(fields: [draftSegmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([draftSegmentId])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.1 — one row per (actor, method, route, client-supplied
// key). Path params are deliberately excluded from the unique key (only requestHash sees them) — see
// the doc for why. encryptedResponseBody is AES-256-GCM with the key held outside the DB
// (IDEMPOTENCY_ENCRYPTION_KEY env var), populated only once status moves to COMPLETED.
model IdempotencyKey {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId           String               @db.Uuid
  httpMethod            String               @db.VarChar(8)
  routeTemplate         String               @db.VarChar(255)
  idempotencyKey        String               @db.Uuid
  requestHash           String               @db.VarChar(64)
  status                IdempotencyKeyStatus
  encryptedResponseBody Bytes?
  statusCode            Int?
  expiresAt             DateTime             @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  actor                 User                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([actorUserId, httpMethod, routeTemplate, idempotencyKey])
}

// ============================================================================
// T7A.1 Attendance Clock — schema foundation slice.
// docs/titanor-time/T7A_1_ATTENDANCE_CLOCK_DESIGN.md §2.1 (entities 1-13), §3 (enums, above),
// §4.1 (raw-SQL triggers — see migration.sql Section B and docs/titanor-time/05_RAW_SQL_REGISTER.md).
// No API/UI/offline-sync/materializer/scheduler code reads or writes these tables yet.
// ============================================================================

// §2.1 п.1 — immutable, editing a geofence creates a new version, never rewrites the old one.
model WorkSiteGeofenceVersion {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String       @db.Uuid
  versionNumber   Int
  latitude        Decimal      @db.Decimal(8, 6)
  longitude       Decimal      @db.Decimal(9, 6)
  radiusMeters    Int
  createdByUserId String       @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  site            WorkSite     @relation("WorkSiteGeofenceVersions", fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User         @relation("GeofenceVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentForSite  WorkSite[]   @relation("WorkSiteCurrentGeofence")
  clockEvents     ClockEvent[]

  @@unique([siteId, versionNumber])
  @@unique([siteId, id])
}

// §2.1 п.2 — mutable, advisory. id is client-generated (not server dbgenerated).
model WorkerDeviceInstallation {
  id                    String                 @id @db.Uuid
  employeeId            String                 @db.Uuid
  userAgent             String?                @db.Text
  platform              String?                @db.VarChar(32)
  installedAt           DateTime               @default(now()) @db.Timestamptz(6)
  lastSeenAt            DateTime               @db.Timestamptz(6)
  revokedAt             DateTime?              @db.Timestamptz(6)
  lastProcessedSequence BigInt                 @default(0)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clockEvents           ClockEvent[]
  clockEventIdConflicts ClockEventIdConflict[]
  deviceEventReceipts   DeviceEventReceipt[]

  @@unique([id, employeeId])
}

// §2.1 п.3 — immutable, append-only. id is client-generated (idempotency key for the event itself).
model ClockEvent {
  id                   String                    @id @db.Uuid
  groupId              String?                   @db.Uuid
  employeeId           String                    @db.Uuid
  deviceInstallationId String?                   @db.Uuid
  deviceSequence       BigInt?
  operationType        ClockOperationType
  siteId               String                    @db.Uuid
  assumedSiteId        String?                   @db.Uuid
  workAreaId           String?                   @db.Uuid
  sourceAssignmentId   String?                   @db.Uuid
  clientCapturedAt     DateTime                  @db.Timestamptz(6)
  capturedOffline      Boolean
  serverReceivedAt     DateTime                  @default(now()) @db.Timestamptz(6)
  effectiveAt          DateTime                  @db.Timestamptz(6)
  clockSkewMs          BigInt?
  gpsAccuracyMeters    Decimal?                  @db.Decimal(6, 1)
  geofenceVersionId    String?                   @db.Uuid
  gpsVerification      GpsVerificationState
  gpsUnavailableReason GpsUnavailableReason?
  processingState      ClockEventProcessingState
  channel              SubmissionChannel
  payloadHash          String                    @db.VarChar(64)
  requestId            String                    @db.Uuid
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6)
  employee             Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deviceInstallation   WorkerDeviceInstallation? @relation(fields: [deviceInstallationId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)
  site                 WorkSite                  @relation("ClockEventSite", fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assumedSite          WorkSite?                 @relation("ClockEventAssumedSite", fields: [assumedSiteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea             WorkArea?                 @relation(fields: [siteId, workAreaId], references: [siteId, id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment     SiteAssignment?           @relation(fields: [sourceAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  geofenceVersion      WorkSiteGeofenceVersion?  @relation(fields: [siteId, geofenceVersionId], references: [siteId, id], onDelete: Restrict, onUpdate: Cascade)
  openedShift          EmployeeOpenShift?
  checkInForShift      ClockShift?               @relation("ClockShiftCheckIn")
  checkOutForShift     ClockShift?               @relation("ClockShiftCheckOut")
  location             ClockEventLocation?
  attendanceExceptions AttendanceException[]
  deviceEventReceipts  DeviceEventReceipt[]

  @@unique([deviceInstallationId, deviceSequence])
  @@unique([id, deviceInstallationId, employeeId, deviceSequence])
  @@index([employeeId, serverReceivedAt])
  @@index([siteId, serverReceivedAt])
  @@index([processingState])
  @@index([groupId])
}

// §2.1 п.4 — immutable until 90-day retention delete. Sole holder of raw GPS coordinates (§4.3).
model ClockEventLocation {
  clockEventId String     @id @db.Uuid
  latitude     Decimal    @db.Decimal(8, 6)
  longitude    Decimal    @db.Decimal(9, 6)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  clockEvent   ClockEvent @relation(fields: [clockEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// §2.1 п.5 — mutable, exactly 0 or 1 row per Employee (employeeId is the PK, not a separate id).
model EmployeeOpenShift {
  employeeId           String          @id @db.Uuid
  id                   String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  openedByClockEventId String          @unique @db.Uuid
  siteId               String          @db.Uuid
  workAreaId           String?         @db.Uuid
  sourceAssignmentId   String?         @db.Uuid
  openedAt             DateTime        @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)
  employee             Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openedByClockEvent   ClockEvent      @relation(fields: [openedByClockEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site                 WorkSite        @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea             WorkArea?       @relation(fields: [workAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment     SiteAssignment? @relation(fields: [sourceAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

// §2.1 п.6 — immutable with two narrow named exceptions (materializationState, sourceAssignmentId)
// plus the FORCE_CLOSE_OPEN_SHIFT path (checkOutEventId stays NULL forever for that row).
model ClockShift {
  id                                 String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId                         String                         @db.Uuid
  checkInEventId                     String                         @unique @db.Uuid
  checkOutEventId                    String?                        @unique @db.Uuid
  siteId                             String                         @db.Uuid
  workAreaId                         String?                        @db.Uuid
  sourceAssignmentId                 String?                        @db.Uuid
  recordedStartAt                    DateTime                       @db.Timestamptz(6)
  recordedEndAt                      DateTime                       @db.Timestamptz(6)
  endAtProvisional                   Boolean                        @default(false)
  forceClosedByUserId                String?                        @db.Uuid
  forceClosedReason                  String?                        @db.Text
  forceClosedAt                      DateTime?                      @db.Timestamptz(6)
  materializationState               ClockShiftMaterializationState @default(PENDING)
  createdAt                          DateTime                       @default(now()) @db.Timestamptz(6)
  employee                           Employee                       @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  checkInEvent                       ClockEvent                     @relation("ClockShiftCheckIn", fields: [checkInEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  checkOutEvent                      ClockEvent?                    @relation("ClockShiftCheckOut", fields: [checkOutEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site                               WorkSite                       @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea                           WorkArea?                      @relation(fields: [workAreaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment                   SiteAssignment?                @relation(fields: [sourceAssignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  forceClosedByUser                  User?                          @relation("ClockShiftForceClosedBy", fields: [forceClosedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fragments                          ClockShiftFragment[]
  attendanceExceptionsAsShift        AttendanceException[]          @relation("AttendanceExceptionClockShift")
  attendanceExceptionsAsRelatedShift AttendanceException[]          @relation("AttendanceExceptionRelatedClockShift")

  @@unique([id, employeeId])
}

// §2.1 п.7 — immutable, single sourceAssignmentId exception. Generalizes SOLE/FIRST_PART/SECOND_PART
// into "however many fragments a shift needs" (fragmentIndex 0..N-1, coverage-checked, §4.1).
model ClockShiftFragment {
  id                            String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clockShiftId                  String                            @db.Uuid
  employeeId                    String                            @db.Uuid
  fragmentIndex                 Int
  payrollPeriodId               String                            @db.Uuid
  timesheetId                   String                            @db.Uuid
  date                          DateTime                          @db.Date
  recordedStartAt               DateTime                          @db.Timestamptz(6)
  recordedEndAt                 DateTime                          @db.Timestamptz(6)
  siteId                        String                            @db.Uuid
  workAreaId                    String?                           @db.Uuid
  sourceAssignmentId            String?                           @db.Uuid
  reportedProjectionState       ClockShiftFragmentProjectionState @default(PENDING)
  createdAt                     DateTime                          @default(now()) @db.Timestamptz(6)
  clockShift                    ClockShift                        @relation(fields: [clockShiftId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)
  payrollPeriod                 PayrollPeriod                     @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  timesheet                     Timesheet                         @relation(fields: [timesheetId, employeeId, payrollPeriodId], references: [id, employeeId, periodId], onDelete: Restrict, onUpdate: Cascade)
  site                          WorkSite                          @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea                      WorkArea?                         @relation(fields: [siteId, workAreaId], references: [siteId, id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment              SiteAssignment?                   @relation(fields: [sourceAssignmentId, employeeId, siteId], references: [id, employeeId, siteId], onDelete: Restrict, onUpdate: Cascade)
  clockShiftAdjustments         ClockShiftAdjustment[]
  attendanceExceptions          AttendanceException[]
  timesheetDraftSegmentOrigin   TimesheetDraftSegment?            @relation("TimesheetDraftSegmentOrigin")
  workSegmentOrigins            WorkSegment[]                     @relation("WorkSegmentOrigin")
  correctionDraftSegmentOrigins CorrectionDraftSegment[]          @relation("CorrectionDraftSegmentOrigin")

  @@unique([clockShiftId, fragmentIndex])
  @@unique([id, employeeId])
  @@unique([id, clockShiftId, employeeId])
}

// §2.1 п.8 — truly immutable, append-only history of edits to a fragment's reported interval.
model ClockShiftAdjustment {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clockShiftFragmentId     String                   @db.Uuid
  clockShiftId             String                   @db.Uuid
  employeeId               String                   @db.Uuid
  changeType               ClockShiftAdjustmentType
  changedByUserId          String                   @db.Uuid
  beforeStartAt            DateTime?                @db.Timestamptz(6)
  afterStartAt             DateTime?                @db.Timestamptz(6)
  beforeEndAt              DateTime?                @db.Timestamptz(6)
  afterEndAt               DateTime?                @db.Timestamptz(6)
  beforeSiteId             String?                  @db.Uuid
  afterSiteId              String?                  @db.Uuid
  beforeWorkAreaId         String?                  @db.Uuid
  afterWorkAreaId          String?                  @db.Uuid
  beforeSourceAssignmentId String?                  @db.Uuid
  afterSourceAssignmentId  String?                  @db.Uuid
  reason                   String                   @db.Text
  changedAt                DateTime                 @default(now()) @db.Timestamptz(6)
  requestId                String                   @db.Uuid
  clockShiftFragment       ClockShiftFragment       @relation(fields: [clockShiftFragmentId, clockShiftId, employeeId], references: [id, clockShiftId, employeeId], onDelete: Restrict, onUpdate: Cascade)
  changedByUser            User                     @relation("ClockShiftAdjustmentChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  afterSourceAssignment    SiteAssignment?          @relation(fields: [afterSourceAssignmentId, employeeId, afterSiteId], references: [id, employeeId, siteId], onDelete: Restrict, onUpdate: Cascade)
}

// §2.1 п.9 — mutable (status/resolved*). One row = one payroll period; a shift spanning multiple
// periods gets multiple rows tied together by clockShiftId.
model AttendanceException {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                 AttendanceExceptionType
  employeeId           String                    @db.Uuid
  timesheetId          String?                   @db.Uuid
  payrollPeriodId      String?                   @db.Uuid
  occurredAt           DateTime                  @db.Timestamptz(6)
  siteId               String?                   @db.Uuid
  clockEventId         String?                   @db.Uuid
  clockShiftId         String?                   @db.Uuid
  clockShiftFragmentId String?                   @db.Uuid
  relatedClockShiftId  String?                   @db.Uuid
  status               AttendanceExceptionStatus @default(OPEN)
  detail               Json?
  resolvedByUserId     String?                   @db.Uuid
  resolvedAt           DateTime?                 @db.Timestamptz(6)
  resolutionNote       String?                   @db.Text
  overlapEndedAt       DateTime?                 @db.Timestamptz(6)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6)
  employee             Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  timesheet            Timesheet?                @relation(fields: [timesheetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payrollPeriod        PayrollPeriod?            @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site                 WorkSite?                 @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clockEvent           ClockEvent?               @relation(fields: [clockEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clockShift           ClockShift?               @relation("AttendanceExceptionClockShift", fields: [clockShiftId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedClockShift    ClockShift?               @relation("AttendanceExceptionRelatedClockShift", fields: [relatedClockShiftId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clockShiftFragment   ClockShiftFragment?       @relation(fields: [clockShiftFragmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedByUser       User?                     @relation("AttendanceExceptionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([siteId, status])
  @@index([employeeId, status])
  @@index([type, status])
  @@index([payrollPeriodId, status])
}

// §2.1 п.10 — append-only, sanitized (never carries raw GPS coordinates, §4.3, ck_conflict_payload_no_gps_coordinates).
model ClockEventIdConflict {
  id                          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conflictType                ClockEventConflictType
  clientEventId               String                    @db.Uuid
  employeeId                  String                    @db.Uuid
  deviceInstallationId        String?                   @db.Uuid
  sanitizedConflictingPayload Json
  conflictingPayloadHash      String                    @db.VarChar(64)
  requestId                   String                    @db.Uuid
  createdAt                   DateTime                  @default(now()) @db.Timestamptz(6)
  employee                    Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deviceInstallation          WorkerDeviceInstallation? @relation(fields: [deviceInstallationId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientEventId])
  @@index([employeeId, createdAt])
}

// §2.1 п.11 — mutable, singleton (singleton column + CHECK + UNIQUE, §4.4). Seeded by this migration.
model CompanyAttendancePolicy {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  singleton                   Boolean  @unique @default(true)
  timezone                    String   @default("Europe/Helsinki") @db.VarChar(64)
  cutoffDaysAfterPeriodEnd    Int      @default(0)
  cutoffTime                  DateTime @default(dbgenerated("'23:59:00'::time")) @db.Time(0)
  systemReopenDebounceMinutes Int      @default(30)
  maxShiftDurationHours       Int      @default(16)
  // GPS step 4 (T11) — server-side geofence-verification accuracy gate. A reading with
  // accuracyMeters above this becomes GPS_NOT_VERIFIED (reason LOW_ACCURACY). Default 75 keeps
  // the previous hard-coded MAX_ACCEPTABLE_ACCURACY_METERS; a site with chronically poor indoor
  // signal (e.g. a shipyard) can be raised here rather than in code.
  maxGpsAccuracyMeters        Int      @default(75)
  updatedByUserId             String?  @db.Uuid
  updatedAt                   DateTime @updatedAt @db.Timestamptz(6)
  createdAt                   DateTime @default(now()) @db.Timestamptz(6)
  updatedByUser               User?    @relation("CompanyAttendancePolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

// §2.1 п.12 — append-only. Identity is (timesheetId, systemReopenGeneration), not cutoffAt.
model AutoSubmissionAttempt {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetId            String               @db.Uuid
  cutoffAt               DateTime             @db.Timestamptz(6)
  systemReopenGeneration Int
  result                 AutoSubmissionResult
  resultingVersionId     String?              @db.Uuid
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  timesheet              Timesheet            @relation(fields: [timesheetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resultingVersion       TimesheetVersion?    @relation(fields: [resultingVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([timesheetId, systemReopenGeneration])
}

// §2.1 п.13 — immutable, append-only. Sole source of truth for one device's FIFO processing ledger.
model DeviceEventReceipt {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceInstallationId String                    @db.Uuid
  employeeId           String                    @db.Uuid
  deviceSequence       BigInt
  clientEventId        String                    @db.Uuid
  outcome              DeviceEventReceiptOutcome
  clockEventId         String?                   @db.Uuid
  rejectionCode        String?                   @db.VarChar(64)
  payloadHash          String                    @db.VarChar(64)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6)
  deviceInstallation   WorkerDeviceInstallation  @relation(fields: [deviceInstallationId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)
  clockEvent           ClockEvent?               @relation(fields: [clockEventId, deviceInstallationId, employeeId, deviceSequence], references: [id, deviceInstallationId, employeeId, deviceSequence], onDelete: Restrict, onUpdate: Cascade)

  @@unique([deviceInstallationId, deviceSequence])
}

// T8.4A — docs/titanor-time/T8_REPORTS_DESIGN.md Addendum "T8.4A". Immutable CSV export history —
// schema foundation only, zero generation/API/download code in this slice (T8.4B). content stores
// the exact generated bytes so a later download never depends on reconstructing data that may have
// since changed (employee/site renames etc. — per-row snapshots on ExportItem cover that part too).
// UPDATE/DELETE are physically banned by trg_export_batch_immutable (raw SQL, see migration).
model ExportBatch {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId           String              @db.Uuid
  format             ExportFormat
  kind               ExportBatchKind
  createdByUserId    String              @db.Uuid
  correctsBatchId    String?             @db.Uuid
  fileName           String              @db.VarChar(255)
  fileHash           String              @db.VarChar(64)
  fileSizeBytes      Int
  rowCount           Int
  content            Bytes
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  period             PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser      User                @relation("ExportBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Self-FK — the batch this one corrects. CASCADE here is FK-semantics-only: trg_export_batch_
  // immutable unconditionally bans DELETE on ExportBatch before any cascade could ever fire, so this
  // action is structurally unreachable — kept as CASCADE (not RESTRICT) per explicit task decision,
  // not as an operational path.
  correctsBatch      ExportBatch?        @relation("ExportBatchCorrection", fields: [correctsBatchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  correctedBy        ExportBatch[]       @relation("ExportBatchCorrection")
  items              ExportItem[]
  // T8.4B — reverse side of CorrectionRequest.coveredByExportBatchId (§BE).
  coveredCorrections CorrectionRequest[] @relation("ExportBatchCoveredCorrections")

  @@index([periodId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdByUserId])
  @@index([correctsBatchId])
}

// One row per canonical (employeeId, siteId, date) bucket included in a batch. workedMinutes uses
// the SAME canonical worked-time semantics as T8.1/T8.2/T8.3 (lib/reporting/worked-time.ts —
// workedMs = grossMs - unpaidBreakMs, paid breaks stay inside worked time) — see Addendum "T8.4A
// FOLLOW-UP" for why an EARLIER version of this migration briefly required a different, incorrect
// formula and why no arithmetic CHECK between the three already-independently-rounded minute
// columns is possible at all (see ck_export_item_minute_bounds instead, 05_RAW_SQL_REGISTER.md §12).
// UPDATE/DELETE are physically banned by trg_export_item_immutable (raw SQL, see migration).
model ExportItem {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exportBatchId          String           @db.Uuid
  employeeId             String           @db.Uuid
  timesheetVersionId     String           @db.Uuid
  siteId                 String           @db.Uuid
  date                   DateTime         @db.Date
  employeeNumberSnapshot String
  employeeNameSnapshot   String
  siteNameSnapshot       String
  grossMinutes           Int
  paidBreakMinutes       Int
  unpaidBreakMinutes     Int
  workedMinutes          Int
  segmentCount           Int
  createdAt              DateTime         @default(now()) @db.Timestamptz(6)
  exportBatch            ExportBatch      @relation(fields: [exportBatchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee               Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site                   WorkSite         @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Composite FK — timesheetVersionId must belong to the same employeeId (TimesheetVersion's own
  // @@unique([id, employeeId]) makes this representable without a trigger).
  timesheetVersion       TimesheetVersion @relation(fields: [timesheetVersionId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)

  // Also the (exportBatchId, employeeId, siteId, date) index the task's own "Индексы" list names —
  // a unique constraint's backing btree index already covers that exact column list; adding a
  // second, identical plain index alongside it would be a pure duplicate.
  @@unique([exportBatchId, employeeId, siteId, date])
  @@index([timesheetVersionId, employeeId])
}
