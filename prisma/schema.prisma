generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  FI
  EN
  RU
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  OFFBOARDING
  DEACTIVATED
}

enum ActivationTokenStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum AuthLevel {
  PASSWORD
  MFA_VERIFIED
}

enum AbsenceType {
  SICK_LEAVE
  VACATION
  UNPAID_LEAVE
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollPeriodStatus {
  OPEN
  LOCKED
  EXPORTED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  RETURNED
  FOREMAN_APPROVED
  FINAL_APPROVED
}

enum DayType {
  WORK
  SICK_LEAVE
  VACATION
  UNPAID_LEAVE
  PUBLIC_HOLIDAY
  OTHER
}

enum TimesheetVersionSource {
  WORKER
  CORRECTION
}

enum TimesheetReviewScopeType {
  SITE
  NON_SITE
}

enum TimesheetReviewScopePurpose {
  DATA
  EMPTY_FALLBACK
}

enum TimesheetReviewScopeStatus {
  PENDING
  APPROVED
  RETURNED
}

enum IdempotencyKeyStatus {
  PROCESSING
  COMPLETED
}

enum CorrectionRequestStatus {
  PENDING
  DRAFT_OPEN
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id                         String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                   String                        @unique @db.VarChar(64)
  email                      String?                       @unique @db.VarChar(255)
  passwordHash               String?                       @db.Text
  status                     UserStatus
  locale                     Locale
  twoFactorEnabled           Boolean                       @default(false)
  twoFactorSecret            String?                       @db.Text
  employeeId                 String?                       @unique @db.Uuid
  lastLoginAt                DateTime?                     @db.Timestamptz(6)
  createdAt                  DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                      @updatedAt @db.Timestamptz(6)
  employee                   Employee?                     @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAbsences            Absence[]                     @relation("AbsenceCreatedBy")
  approvedAbsences           Absence[]                     @relation("AbsenceApprovedBy")
  assignedAssignments        SiteAssignment[]              @relation("SiteAssignmentAssignedBy")
  defaultForemanSites        WorkSite[]                    @relation("WorkSiteDefaultForeman")
  foremanAssignments         ForemanAssignment[]           @relation("ForemanAssignmentForeman")
  assignedForemanAssignments ForemanAssignment[]           @relation("ForemanAssignmentAssignedBy")
  openedPeriods              PayrollPeriod[]               @relation("PayrollPeriodOpenedBy")
  lockedPeriods              PayrollPeriod[]               @relation("PayrollPeriodLockedBy")
  excludedParticipants       PayrollPeriodParticipant[]    @relation("PayrollPeriodParticipantExcludedBy")
  createdTemplateVersions    WorkScheduleTemplateVersion[] @relation("TemplateVersionCreatedBy")
  createdTimesheetVersions   TimesheetVersion[]            @relation("TimesheetVersionCreatedBy")
  reviewedTimesheetScopes    TimesheetReviewScope[]        @relation("TimesheetReviewScopeReviewedBy")
  requestedCorrections       CorrectionRequest[]           @relation("CorrectionRequestRequestedBy")
  decidedCorrections         CorrectionRequest[]           @relation("CorrectionRequestDecidedBy")
  openedCorrectionDrafts     CorrectionDraft[]             @relation("CorrectionDraftOpenedBy")
  issuedActivationTokens     ActivationToken[]             @relation("ActivationTokenCreatedBy")
  userRoles                  UserRole[]
  userSessions               UserSession[]
  auditEvents                AuditEvent[]
  idempotencyKeys            IdempotencyKey[]
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @unique @db.VarChar(32)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(128)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  validFrom DateTime  @default(now()) @db.Timestamptz(6)
  validTo   DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([roleId])
}

model UserSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.VarChar(64)
  authLevel     AuthLevel @default(PASSWORD)
  mfaVerifiedAt DateTime? @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(6)
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.Text
  revokedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.1 "ActivationToken" — T7.9-adjacent activation
// vertical slice. tokenHash is HMAC-SHA256(ACTIVATION_TOKEN_HMAC_KEY, normalizedCode), not
// Argon2id — GET /api/auth/activate must find the row by a single deterministic equality
// lookup on the code the user actually typed/scanned, which Argon2id's per-call salting
// doesn't allow. @unique on tokenHash both enables that lookup and guards the
// (astronomically unlikely) HMAC collision case, per owner instruction.
model ActivationToken {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String                @db.Uuid
  tokenHash       String                @unique @db.VarChar(64)
  status          ActivationTokenStatus @default(PENDING)
  expiresAt       DateTime              @db.Timestamptz(6)
  createdByUserId String                @db.Uuid
  usedAt          DateTime?             @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User                  @relation("ActivationTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([employeeId, status])
  @@index([expiresAt])
}

model Employee {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeNumber     String                     @unique
  firstName          String
  lastName           String
  phone              String?
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(6)
  user               User?
  employments        Employment[]
  absences           Absence[]
  activationTokens   ActivationToken[]
  siteAssignments    SiteAssignment[]
  periodParticipants PayrollPeriodParticipant[]
  timesheets         Timesheet[]
}

model Employment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId         String    @db.Uuid
  active             Boolean
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date
  deactivationReason String?   @db.Text
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([employeeId, active])
}

model Absence {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String               @db.Uuid
  startDate           DateTime             @db.Date
  endDate             DateTime             @db.Date
  type                AbsenceType
  status              AbsenceStatus
  note                String?              @db.Text
  createdByUserId     String               @db.Uuid
  approvedByUserId    String?              @db.Uuid
  approvedAt          DateTime?            @db.Timestamptz(6)
  overlayAppliedDates Json?
  overlayConflicts    Json?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser       User                 @relation("AbsenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedByUser      User?                @relation("AbsenceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  draftDays           TimesheetDraftDay[]
  timesheetDays       TimesheetDay[]
  correctionDraftDays CorrectionDraftDay[]

  @@index([employeeId, status, startDate, endDate])
}

model City {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  sites     WorkSite[]
}

model WorkSite {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  cityId                  String?                      @db.Uuid
  address                 String?
  description             String?                      @db.Text
  active                  Boolean                      @default(true)
  defaultForemanUserId    String?                      @db.Uuid
  version                 Int                          @default(1)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(6)
  city                    City?                        @relation(fields: [cityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  defaultForemanUser      User?                        @relation("WorkSiteDefaultForeman", fields: [defaultForemanUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  workAreas               WorkArea[]
  siteAssignments         SiteAssignment[]
  foremanAssignments      ForemanAssignment[]
  draftPlannedShifts      TimesheetDraftPlannedShift[]
  draftSegments           TimesheetDraftSegment[]
  plannedShifts           TimesheetPlannedShift[]
  workSegments            WorkSegment[]
  reviewScopes            TimesheetReviewScope[]       @relation("TimesheetReviewScopeSite")
  reviewScopeContexts     TimesheetReviewScope[]       @relation("TimesheetReviewScopeContextSite")
  correctionDraftSegments CorrectionDraftSegment[]

  @@index([cityId])
  @@index([active])
}

model WorkArea {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId                  String                   @db.Uuid
  name                    String
  active                  Boolean                  @default(true)
  version                 Int                      @default(1)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(6)
  site                    WorkSite                 @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  siteAssignments         SiteAssignment[]
  draftSegments           TimesheetDraftSegment[]
  workSegments            WorkSegment[]
  correctionDraftSegments CorrectionDraftSegment[]

  @@unique([siteId, name])
  @@unique([siteId, id])
  @@index([siteId, active])
}

model WorkScheduleTemplate {
  id          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?                       @db.Text
  active      Boolean                       @default(true)
  createdAt   DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                      @updatedAt @db.Timestamptz(6)
  versions    WorkScheduleTemplateVersion[]
}

model WorkScheduleTemplateVersion {
  id              String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId      String                           @db.Uuid
  versionNumber   Int
  createdByUserId String                           @db.Uuid
  effectiveFrom   DateTime                         @db.Timestamptz(6)
  createdAt       DateTime                         @default(now()) @db.Timestamptz(6)
  template        WorkScheduleTemplate             @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User                             @relation("TemplateVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  days            WorkScheduleTemplateVersionDay[]
  siteAssignments SiteAssignment[]

  @@unique([templateId, versionNumber])
  @@index([createdByUserId])
}

model WorkScheduleTemplateVersionDay {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateVersionId   String                       @db.Uuid
  weekday             Int                          @db.SmallInt
  isWorkingDay        Boolean
  plannedStartTime    DateTime?                    @db.Time(0)
  plannedEndTime      DateTime?                    @db.Time(0)
  plannedBreakMinutes Int
  createdAt           DateTime                     @default(now()) @db.Timestamptz(6)
  templateVersion     WorkScheduleTemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  draftPlannedShifts  TimesheetDraftPlannedShift[]
  plannedShifts       TimesheetPlannedShift[]

  @@unique([templateVersionId, weekday])
}

model SiteAssignment {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId              String                       @db.Uuid
  siteId                  String                       @db.Uuid
  workAreaId              String?                      @db.Uuid
  templateVersionId       String?                      @db.Uuid
  isPrimary               Boolean
  validFrom               DateTime                     @db.Date
  validTo                 DateTime?                    @db.Date
  assignedByUserId        String                       @db.Uuid
  endedReason             String?                      @db.Text
  version                 Int                          @default(1)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(6)
  employee                Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site                    WorkSite                     @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea                WorkArea?                    @relation(fields: [siteId, workAreaId], references: [siteId, id], onDelete: Restrict, onUpdate: Cascade)
  templateVersion         WorkScheduleTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUser          User                         @relation("SiteAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  draftPlannedShifts      TimesheetDraftPlannedShift[]
  draftSegments           TimesheetDraftSegment[]
  plannedShifts           TimesheetPlannedShift[]
  workSegments            WorkSegment[]
  correctionDraftSegments CorrectionDraftSegment[]

  @@unique([id, employeeId, siteId])
  @@index([employeeId, validFrom, validTo])
  @@index([siteId, validFrom, validTo])
  @@index([templateVersionId])
  @@index([assignedByUserId])
}

model ForemanAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  foremanUserId    String    @db.Uuid
  siteId           String    @db.Uuid
  isSubstitute     Boolean   @default(false)
  validFrom        DateTime  @db.Date
  validTo          DateTime? @db.Date
  assignedByUserId String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  foremanUser      User      @relation("ForemanAssignmentForeman", fields: [foremanUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site             WorkSite  @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedByUser   User      @relation("ForemanAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([siteId, validFrom, validTo])
}

model PayrollPeriod {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startDate      DateTime                   @db.Date
  endDate        DateTime                   @db.Date
  status         PayrollPeriodStatus
  openedByUserId String                     @db.Uuid
  lockedAt       DateTime?                  @db.Timestamptz(6)
  lockedByUserId String?                    @db.Uuid
  exportedAt     DateTime?                  @db.Timestamptz(6)
  version        Int                        @default(1)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @db.Timestamptz(6)
  openedByUser   User                       @relation("PayrollPeriodOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lockedByUser   User?                      @relation("PayrollPeriodLockedBy", fields: [lockedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  participants   PayrollPeriodParticipant[]
  timesheets     Timesheet[]

  @@index([status, startDate, endDate])
}

model PayrollPeriodParticipant {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId         String        @db.Uuid
  employeeId       String        @db.Uuid
  expected         Boolean       @default(true)
  exclusionReason  String?       @db.Text
  excludedByUserId String?       @db.Uuid
  excludedAt       DateTime?     @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  period           PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  excludedByUser   User?         @relation("PayrollPeriodParticipantExcludedBy", fields: [excludedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  timesheets       Timesheet[]

  @@unique([periodId, employeeId])
  @@index([employeeId, expected])
  @@index([periodId, expected])
}

model Timesheet {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId         String                   @db.Uuid
  periodId           String                   @db.Uuid
  status             TimesheetStatus
  currentVersionId   String?                  @db.Uuid
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(6)
  employee           Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  period             PayrollPeriod            @relation(fields: [periodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  participant        PayrollPeriodParticipant @relation(fields: [periodId, employeeId], references: [periodId, employeeId], onDelete: Restrict, onUpdate: Cascade)
  currentVersion     TimesheetVersion?        @relation("TimesheetCurrentVersion", fields: [currentVersionId, id], references: [id, timesheetId], onDelete: Restrict, onUpdate: Cascade)
  draft              TimesheetDraft?
  versions           TimesheetVersion[]       @relation("TimesheetVersions")
  correctionRequests CorrectionRequest[]

  @@unique([employeeId, periodId])
  @@unique([id, employeeId])
  @@index([periodId, status])
  @@index([currentVersionId])
}

model TimesheetDraft {
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetId            String                       @unique @db.Uuid
  employeeId             String                       @db.Uuid
  basedOnVersionId       String?                      @db.Uuid
  contentRevision        BigInt                       @default(0)
  createdAt              DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(6)
  timesheet              Timesheet                    @relation(fields: [timesheetId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)
  basedOnVersion         TimesheetVersion?            @relation("TimesheetDraftBaseVersion", fields: [basedOnVersionId, timesheetId], references: [id, timesheetId], onDelete: Restrict, onUpdate: Cascade)
  days                   TimesheetDraftDay[]
  plannedShifts          TimesheetDraftPlannedShift[]
  timesheetDraftSegments TimesheetDraftSegment[]

  @@unique([id, employeeId])
  @@unique([timesheetId, employeeId])
  @@index([timesheetId, employeeId])
  @@index([basedOnVersionId])
}

model TimesheetDraftDay {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftId         String                  @db.Uuid
  date            DateTime                @db.Date
  dayType         DayType
  confirmedZero   Boolean                 @default(false)
  sourceAbsenceId String?                 @db.Uuid
  note            String?                 @db.Text
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  draft           TimesheetDraft          @relation(fields: [draftId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceAbsence   Absence?                @relation(fields: [sourceAbsenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  segments        TimesheetDraftSegment[]

  @@unique([draftId, date])
  @@unique([id, draftId])
  @@unique([id, draftId, date])
  @@unique([id, date])
  @@index([sourceAbsenceId])
}

model TimesheetDraftPlannedShift {
  id                   String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftId              String                          @db.Uuid
  employeeId           String                          @db.Uuid
  date                 DateTime                        @db.Date
  siteId               String                          @db.Uuid
  sourceAssignmentId   String                          @db.Uuid
  templateVersionDayId String?                         @db.Uuid
  plannedStartAt       DateTime?                       @db.Timestamptz(6)
  plannedEndAt         DateTime?                       @db.Timestamptz(6)
  plannedBreakMinutes  Int                             @default(0)
  createdAt            DateTime                        @default(now()) @db.Timestamptz(6)
  draft                TimesheetDraft                  @relation(fields: [draftId, employeeId], references: [id, employeeId], onDelete: Cascade, onUpdate: Cascade)
  site                 WorkSite                        @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment     SiteAssignment                  @relation(fields: [sourceAssignmentId, employeeId, siteId], references: [id, employeeId, siteId], onDelete: Restrict, onUpdate: Cascade)
  templateVersionDay   WorkScheduleTemplateVersionDay? @relation(fields: [templateVersionDayId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  segments             TimesheetDraftSegment[]         @relation("DraftSegmentPlannedShift")

  @@unique([draftId, date, sourceAssignmentId])
  @@index([draftId, employeeId])
  @@index([siteId, date])
  @@index([sourceAssignmentId, employeeId, siteId])
}

model TimesheetDraftSegment {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftDayId         String                       @db.Uuid
  draftId            String                       @db.Uuid
  employeeId         String                       @db.Uuid
  date               DateTime                     @db.Date
  startAt            DateTime                     @db.Timestamptz(6)
  endAt              DateTime                     @db.Timestamptz(6)
  siteId             String                       @db.Uuid
  workAreaId         String?                      @db.Uuid
  sourceAssignmentId String                       @db.Uuid
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(6)
  draftDay           TimesheetDraftDay            @relation(fields: [draftDayId, draftId, date], references: [id, draftId, date], onDelete: Cascade, onUpdate: Cascade)
  draft              TimesheetDraft               @relation(fields: [draftId, employeeId], references: [id, employeeId], onDelete: Cascade, onUpdate: Cascade)
  site               WorkSite                     @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea           WorkArea?                    @relation(fields: [siteId, workAreaId], references: [siteId, id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment   SiteAssignment               @relation(fields: [sourceAssignmentId, employeeId, siteId], references: [id, employeeId, siteId], onDelete: Restrict, onUpdate: Cascade)
  plannedShift       TimesheetDraftPlannedShift   @relation("DraftSegmentPlannedShift", fields: [draftId, date, sourceAssignmentId], references: [draftId, date, sourceAssignmentId], onDelete: Restrict, onUpdate: Cascade)
  breaks             TimesheetDraftBreakSegment[]

  @@index([draftDayId, draftId])
  @@index([draftId, employeeId])
  @@index([draftId, date, sourceAssignmentId])
  @@index([sourceAssignmentId, employeeId, siteId])
  @@index([siteId, date])
}

model TimesheetDraftBreakSegment {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftSegmentId String                @db.Uuid
  startAt        DateTime              @db.Timestamptz(6)
  endAt          DateTime              @db.Timestamptz(6)
  paid           Boolean
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(6)
  draftSegment   TimesheetDraftSegment @relation(fields: [draftSegmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([draftSegmentId])
}

model TimesheetVersion {
  id                          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetId                 String                  @db.Uuid
  employeeId                  String                  @db.Uuid
  versionNumber               Int
  source                      TimesheetVersionSource
  createdByUserId             String                  @db.Uuid
  note                        String?                 @db.Text
  createdAt                   DateTime                @default(now()) @db.Timestamptz(6)
  timesheet                   Timesheet               @relation("TimesheetVersions", fields: [timesheetId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)
  createdByUser               User                    @relation("TimesheetVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentForTimesheet         Timesheet[]             @relation("TimesheetCurrentVersion")
  basedDrafts                 TimesheetDraft[]        @relation("TimesheetDraftBaseVersion")
  days                        TimesheetDay[]
  plannedShifts               TimesheetPlannedShift[]
  workSegments                WorkSegment[]
  reviewScopes                TimesheetReviewScope[]
  correctionRequestsResulting CorrectionRequest[]     @relation("CorrectionRequestResultingVersion")
  correctionDraftsBasedOn     CorrectionDraft[]       @relation("CorrectionDraftBaseVersion")

  @@unique([timesheetId, versionNumber])
  @@unique([id, employeeId])
  @@unique([id, timesheetId])
  @@index([timesheetId, employeeId])
  @@index([createdByUserId])
}

model TimesheetDay {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetVersionId String           @db.Uuid
  date               DateTime         @db.Date
  dayType            DayType
  confirmedZero      Boolean
  sourceAbsenceId    String?          @db.Uuid
  note               String?          @db.Text
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  timesheetVersion   TimesheetVersion @relation(fields: [timesheetVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceAbsence      Absence?         @relation(fields: [sourceAbsenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  segments           WorkSegment[]

  @@unique([timesheetVersionId, date])
  @@unique([id, timesheetVersionId])
  @@unique([id, timesheetVersionId, date])
  @@unique([id, date])
  @@index([sourceAbsenceId])
}

model TimesheetPlannedShift {
  id                   String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetVersionId   String                          @db.Uuid
  employeeId           String                          @db.Uuid
  date                 DateTime                        @db.Date
  siteId               String                          @db.Uuid
  sourceAssignmentId   String                          @db.Uuid
  templateVersionDayId String?                         @db.Uuid
  plannedStartAt       DateTime?                       @db.Timestamptz(6)
  plannedEndAt         DateTime?                       @db.Timestamptz(6)
  plannedBreakMinutes  Int                             @default(0)
  createdAt            DateTime                        @default(now()) @db.Timestamptz(6)
  timesheetVersion     TimesheetVersion                @relation(fields: [timesheetVersionId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)
  site                 WorkSite                        @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment     SiteAssignment                  @relation(fields: [sourceAssignmentId, employeeId, siteId], references: [id, employeeId, siteId], onDelete: Restrict, onUpdate: Cascade)
  templateVersionDay   WorkScheduleTemplateVersionDay? @relation(fields: [templateVersionDayId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  segments             WorkSegment[]                   @relation("WorkSegmentPlannedShift")

  @@unique([timesheetVersionId, date, sourceAssignmentId])
  @@index([timesheetVersionId, employeeId])
  @@index([siteId, date])
  @@index([sourceAssignmentId, employeeId, siteId])
}

model WorkSegment {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetDayId     String                @db.Uuid
  timesheetVersionId String                @db.Uuid
  employeeId         String                @db.Uuid
  date               DateTime              @db.Date
  startAt            DateTime              @db.Timestamptz(6)
  endAt              DateTime              @db.Timestamptz(6)
  siteId             String                @db.Uuid
  workAreaId         String?               @db.Uuid
  sourceAssignmentId String                @db.Uuid
  crossesMidnight    Boolean
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  timesheetDay       TimesheetDay          @relation(fields: [timesheetDayId, timesheetVersionId, date], references: [id, timesheetVersionId, date], onDelete: Restrict, onUpdate: Cascade)
  timesheetVersion   TimesheetVersion      @relation(fields: [timesheetVersionId, employeeId], references: [id, employeeId], onDelete: Restrict, onUpdate: Cascade)
  site               WorkSite              @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea           WorkArea?             @relation(fields: [siteId, workAreaId], references: [siteId, id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment   SiteAssignment        @relation(fields: [sourceAssignmentId, employeeId, siteId], references: [id, employeeId, siteId], onDelete: Restrict, onUpdate: Cascade)
  plannedShift       TimesheetPlannedShift @relation("WorkSegmentPlannedShift", fields: [timesheetVersionId, date, sourceAssignmentId], references: [timesheetVersionId, date, sourceAssignmentId], onDelete: Restrict, onUpdate: Cascade)
  breaks             BreakSegment[]

  @@index([timesheetDayId, timesheetVersionId])
  @@index([timesheetVersionId, employeeId])
  @@index([timesheetVersionId, date, sourceAssignmentId])
  @@index([sourceAssignmentId, employeeId, siteId])
  @@index([siteId, date])
}

model BreakSegment {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workSegmentId String      @db.Uuid
  startAt       DateTime    @db.Timestamptz(6)
  endAt         DateTime    @db.Timestamptz(6)
  paid          Boolean
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  workSegment   WorkSegment @relation(fields: [workSegmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([workSegmentId])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.6 "TimesheetReviewScope" — created by
// timesheet.submit (ЭТАП 7 sub-task 4), one per SITE with data plus at most one NON_SITE
// (DATA or EMPTY_FALLBACK) per version. TimesheetReviewProposal (child of this, created only by
// scope.return) is deliberately not part of this schema yet — no endpoint creates it until
// sub-task 5 (foreman/admin review), so there is nothing to reference it.
model TimesheetReviewScope {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetVersionId String                       @db.Uuid
  scopeType          TimesheetReviewScopeType
  scopePurpose       TimesheetReviewScopePurpose?
  siteId             String?                      @db.Uuid
  contextSiteId      String?                      @db.Uuid
  status             TimesheetReviewScopeStatus
  contentHash        String                       @db.VarChar(64)
  carriedFromScopeId String?                      @db.Uuid
  reviewedByUserId   String?                      @db.Uuid
  reviewedAt         DateTime?                    @db.Timestamptz(6)
  returnReason       String?                      @db.Text
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(6)
  timesheetVersion   TimesheetVersion             @relation(fields: [timesheetVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site               WorkSite?                    @relation("TimesheetReviewScopeSite", fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contextSite        WorkSite?                    @relation("TimesheetReviewScopeContextSite", fields: [contextSiteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  carriedFromScope   TimesheetReviewScope?        @relation("TimesheetReviewScopeCarriedFrom", fields: [carriedFromScopeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  carriedToScopes    TimesheetReviewScope[]       @relation("TimesheetReviewScopeCarriedFrom")
  reviewedByUser     User?                        @relation("TimesheetReviewScopeReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([id, timesheetVersionId])
  @@index([timesheetVersionId])
  @@index([siteId, status])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.8 — immutable, append-only (enforced by
// trg_audit_event_immutable in this migration's raw SQL, not by any API write path —
// audit.read is the only permission touching this table, per
// 02_ROLE_PERMISSION_MATRIX.md §2.10). actorUserId/entityId nullable per owner decision
// (2026-07-31): LOGIN_FAILED for an unrecognized identifier has no resolvable User and
// no single domain entity — entityType="AUTHENTICATION", entityId=NULL in that case.
model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  eventType   String   @db.VarChar(64)
  entityType  String   @db.VarChar(64)
  entityId    String?  @db.Uuid
  beforeValue Json?
  afterValue  Json?
  reason      String?  @db.Text
  requestId   String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.7 "CorrectionRequest"/"CorrectionDraft*" — T7.9
// (correction of a FINAL_APPROVED timesheet). request/draftId form a mutual 1:1 pointer pair
// exactly as documented: CorrectionDraft.correctionRequestId is the authoritative, required,
// unique backlink; CorrectionRequest.draftId is a nullable convenience pointer set at the same
// time (starts NULL at PENDING, set once correction.draft.edit opens the draft). CorrectionDraft
// has no plannedShift entity of its own (corrections compare only against basedOnVersionId, never
// a plan, §4.5) — CorrectionDraftSegment has no plannedShift FK, unlike TimesheetDraftSegment.
model CorrectionRequest {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timesheetId        String                  @db.Uuid
  requestedByUserId  String                  @db.Uuid
  reason             String                  @db.Text
  status             CorrectionRequestStatus
  draftId            String?                 @unique @db.Uuid
  decidedByUserId    String?                 @db.Uuid
  decidedAt          DateTime?               @db.Timestamptz(6)
  resultingVersionId String?                 @db.Uuid
  approvalOverride   Boolean                 @default(false)
  overrideReason     String?                 @db.Text
  pendingExport      Boolean                 @default(false)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)
  timesheet          Timesheet               @relation(fields: [timesheetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedByUser    User                    @relation("CorrectionRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decidedByUser      User?                   @relation("CorrectionRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resultingVersion   TimesheetVersion?       @relation("CorrectionRequestResultingVersion", fields: [resultingVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  draft              CorrectionDraft?        @relation("CorrectionRequestDraftPointer", fields: [draftId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  draftOwner         CorrectionDraft?        @relation("CorrectionDraftOwnRequest")

  @@index([timesheetId, status])
  @@index([requestedByUserId])
  @@index([decidedByUserId])
}

model CorrectionDraft {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correctionRequestId String                   @unique @db.Uuid
  employeeId          String                   @db.Uuid
  basedOnVersionId    String                   @db.Uuid
  openedByUserId      String                   @db.Uuid
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  submittedAt         DateTime?                @db.Timestamptz(6)
  correctionRequest   CorrectionRequest        @relation("CorrectionDraftOwnRequest", fields: [correctionRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  basedOnVersion      TimesheetVersion         @relation("CorrectionDraftBaseVersion", fields: [basedOnVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openedByUser        User                     @relation("CorrectionDraftOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pointerFromRequest  CorrectionRequest?       @relation("CorrectionRequestDraftPointer")
  days                CorrectionDraftDay[]
  segments            CorrectionDraftSegment[]

  @@unique([id, employeeId])
}

model CorrectionDraftDay {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftId         String                   @db.Uuid
  date            DateTime                 @db.Date
  dayType         DayType
  confirmedZero   Boolean                  @default(false)
  sourceAbsenceId String?                  @db.Uuid
  note            String?                  @db.Text
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  draft           CorrectionDraft          @relation(fields: [draftId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceAbsence   Absence?                 @relation(fields: [sourceAbsenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  segments        CorrectionDraftSegment[]

  @@unique([draftId, date])
  @@unique([id, draftId])
  @@unique([id, draftId, date])
  @@unique([id, date])
  @@index([sourceAbsenceId])
}

model CorrectionDraftSegment {
  id                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftDayId         String                        @db.Uuid
  draftId            String                        @db.Uuid
  employeeId         String                        @db.Uuid
  date               DateTime                      @db.Date
  startAt            DateTime                      @db.Timestamptz(6)
  endAt              DateTime                      @db.Timestamptz(6)
  siteId             String                        @db.Uuid
  workAreaId         String?                       @db.Uuid
  sourceAssignmentId String                        @db.Uuid
  createdAt          DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                      @updatedAt @db.Timestamptz(6)
  draftDay           CorrectionDraftDay            @relation(fields: [draftDayId, draftId, date], references: [id, draftId, date], onDelete: Cascade, onUpdate: Cascade)
  draft              CorrectionDraft               @relation(fields: [draftId, employeeId], references: [id, employeeId], onDelete: Cascade, onUpdate: Cascade)
  site               WorkSite                      @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workArea           WorkArea?                     @relation(fields: [siteId, workAreaId], references: [siteId, id], onDelete: Restrict, onUpdate: Cascade)
  sourceAssignment   SiteAssignment                @relation(fields: [sourceAssignmentId, employeeId, siteId], references: [id, employeeId, siteId], onDelete: Restrict, onUpdate: Cascade)
  breaks             CorrectionDraftBreakSegment[]

  @@index([draftDayId, draftId])
  @@index([draftId, employeeId])
  @@index([sourceAssignmentId, employeeId, siteId])
  @@index([siteId, date])
}

model CorrectionDraftBreakSegment {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftSegmentId String                 @db.Uuid
  startAt        DateTime               @db.Timestamptz(6)
  endAt          DateTime               @db.Timestamptz(6)
  paid           Boolean
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  draftSegment   CorrectionDraftSegment @relation(fields: [draftSegmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([draftSegmentId])
}

// docs/titanor-time/03_DATA_MODEL_ERD.md §4.1 — one row per (actor, method, route, client-supplied
// key). Path params are deliberately excluded from the unique key (only requestHash sees them) — see
// the doc for why. encryptedResponseBody is AES-256-GCM with the key held outside the DB
// (IDEMPOTENCY_ENCRYPTION_KEY env var), populated only once status moves to COMPLETED.
model IdempotencyKey {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId           String               @db.Uuid
  httpMethod            String               @db.VarChar(8)
  routeTemplate         String               @db.VarChar(255)
  idempotencyKey        String               @db.Uuid
  requestHash           String               @db.VarChar(64)
  status                IdempotencyKeyStatus
  encryptedResponseBody Bytes?
  statusCode            Int?
  expiresAt             DateTime             @db.Timestamptz(6)
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  actor                 User                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([actorUserId, httpMethod, routeTemplate, idempotencyKey])
}
