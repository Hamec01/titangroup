# Titanor Time — isolated PostgreSQL 16 (compose.titanor-time.yaml)
#
# Copy this file to `.env.titanor-time` (same directory) and fill in real
# values. `.env.titanor-time` is already covered by the `.env.*` rule in
# .gitignore — never commit it, never put real values in this .example file.
#
# These three variables are consumed directly by the official postgres:16
# image inside the `db` service. Do not rename them.

POSTGRES_DB=titanor_time
POSTGRES_USER=titanor_time_app
POSTGRES_PASSWORD=change-me

# Consumed by the `app` service (Prisma Client). Leave empty here — never put
# a real connection string or password in this .example file. When filling in
# .env.titanor-time for real, host must be the internal Compose service name
# `db` (not localhost, not a public address), matching the three values above:
# DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=

# Consumed by the `app` service — keyed HMAC-SHA256 secret for ActivationToken.tokenHash
# (titanor-time-app/lib/activation-secret.ts). Separate from every other key in this file —
# never reuse IDEMPOTENCY_ENCRYPTION_KEY or any other secret here. Must be exactly 32
# cryptographically random bytes, base64-encoded (e.g. `openssl rand -base64 32`). The app
# validates the decoded length at use and refuses to start an activation flow otherwise. Leave
# empty here — never put a real value in this .example file.
ACTIVATION_TOKEN_HMAC_KEY=
